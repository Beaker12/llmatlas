digraph shuffle {
  graph [fontname="DejaVu Sans", fontsize=23, nodesep=0.3, ranksep=0.45, pad=0.2];
  node [fontname="DejaVu Sans", fontsize=21, fontcolor="#1a202c", shape=box, style="rounded,filled", fillcolor="#ffffff", color="#4a5568", penwidth=1.3]; edge [fontname="DejaVu Sans", fontsize=21, fontcolor="#1a202c", color="#4a5568", penwidth=1.2];
  subgraph cluster_storage { label="object storage"; style="rounded,filled"; fillcolor="#edf2f7"; color="#4a5568"; fontsize=21;
    s0 [label="shard 0"]; s1 [label="shard 1"]; s2 [label="shard 2"]; s3 [label="shard 3"];
  }
  order [label="1. Across shards\nvisit in a seeded order:\n2, 0, 3, 1", fillcolor="#dbeafe"];
  within [label="2. Within a shard\npermute its documents\nas it is read", fillcolor="#dbeafe"];
  buffer [shape=plain, style="", label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#4a5568"><TR><TD COLSPAN="8" BORDER="0"><B>Shuffle buffer</B> (a few thousand documents)</TD></TR><TR><TD BGCOLOR="#dcfce7">d</TD><TD BGCOLOR="#dcfce7">d</TD><TD BGCOLOR="#fde7cf">d</TD><TD BGCOLOR="#dcfce7">d</TD><TD BGCOLOR="#dcfce7">d</TD><TD BGCOLOR="#dcfce7">d</TD><TD BGCOLOR="#dcfce7">d</TD><TD BGCOLOR="#dcfce7">…</TD></TR><TR><TD COLSPAN="8" BORDER="0">emit a random slot (orange), refill it from the stream</TD></TR></TABLE>>];
  batch [label="Training batches"];
  global [label="3. Across the whole corpus\none global permutation\nneeds random access to any document", fillcolor="#fde7cf", style="rounded,filled,dashed"];
  s2 -> order; s0 -> order; s3 -> order; s1 -> order;
  order -> within -> buffer -> batch;
  global -> batch [style=dashed, label="ideal; the buffer\napproximates it"];
  {rank=same; buffer; global}
  {rank=same; s0; s1; s2; s3}
}
