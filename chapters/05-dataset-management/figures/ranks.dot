digraph ranks {
  graph [fontname="DejaVu Sans", fontsize=13, nodesep=0.3, ranksep=0.45, pad=0.2];
  node [fontname="DejaVu Sans", fontsize=12, fontcolor="#1a202c", shape=box, style="rounded,filled", fillcolor="#ffffff", color="#4a5568", penwidth=1.3]; edge [fontname="DejaVu Sans", fontsize=11, fontcolor="#1a202c", color="#4a5568", penwidth=1.2];
  subgraph cluster_sa { label="Shard assignment: rank r reads shards r, r + W, r + 2W, …"; style="rounded,filled"; fillcolor="#edf2f7"; color="#4a5568"; fontsize=12;
  sa2 [shape=plain, style="", label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#4a5568"><TR><TD BORDER="0"><B>W = 2</B></TD><TD BGCOLOR="#ffffff">rank 0<BR/>shards 0, 2, 4, 6, 8<BR/>documents 12–15</TD><TD BGCOLOR="#ffffff">rank 1<BR/>shards 1, 3, 5, 7, 9<BR/>documents 28–31</TD></TR></TABLE>>];
  sa4 [shape=plain, style="", label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#4a5568"><TR><TD BORDER="0"><B>W = 4</B></TD><TD BGCOLOR="#ffffff">rank 0<BR/>shards 0, 4, 8<BR/>documents 6, 7</TD><TD BGCOLOR="#ffffff">rank 1<BR/>shards 1, 5, 9<BR/>documents 22, 23</TD><TD BGCOLOR="#ffffff">rank 2<BR/>shards 2, 6<BR/>documents 38, 39</TD><TD BGCOLOR="#ffffff">rank 3<BR/>shards 3, 7<BR/>documents 54, 55</TD></TR></TABLE>>];
    saout [label="global batch depends on W:\n{12–15, 28–31} at W = 2\n{6, 7, 22, 23, 38, 39, 54, 55} at W = 4", fillcolor="#fde7cf"];
    sa2 -> sa4 [style=invis];
    sa4 -> saout;
  }
  subgraph cluster_gi { label="Global indexing: rank r takes slice r of global positions 3B … 3B + B − 1"; style="rounded,filled"; fillcolor="#edf2f7"; color="#4a5568"; fontsize=12;
  gi2 [shape=plain, style="", label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#4a5568"><TR><TD BORDER="0"><B>W = 2</B></TD><TD BGCOLOR="#ffffff">rank 0<BR/>samples 24–27</TD><TD BGCOLOR="#ffffff">rank 1<BR/>samples 28–31</TD></TR></TABLE>>];
  gi4 [shape=plain, style="", label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#4a5568"><TR><TD BORDER="0"><B>W = 4</B></TD><TD BGCOLOR="#ffffff">rank 0<BR/>samples 24, 25</TD><TD BGCOLOR="#ffffff">rank 1<BR/>samples 26, 27</TD><TD BGCOLOR="#ffffff">rank 2<BR/>samples 28, 29</TD><TD BGCOLOR="#ffffff">rank 3<BR/>samples 30, 31</TD></TR></TABLE>>];
    giout [label="global batch is samples 24–31 for any W", fillcolor="#dcfce7"];
    gi2 -> gi4 [style=invis];
    gi4 -> giout;
  }
  title [shape=plain, style="", label="Step 3, global batch B = 8, 10 shards of 16 documents"];
  title -> sa2 [style=invis];
  saout -> gi2 [style=invis];
}
