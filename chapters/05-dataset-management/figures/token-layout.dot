digraph token_layout {
  graph [fontname="DejaVu Sans", fontsize=13, nodesep=0.3, ranksep=0.45, pad=0.2];
  node [fontname="DejaVu Sans", fontsize=12, fontcolor="#1a202c", shape=box, style="rounded,filled", fillcolor="#ffffff", color="#4a5568", penwidth=1.3]; edge [fontname="DejaVu Sans", fontsize=11, fontcolor="#1a202c", color="#4a5568", penwidth=1.2];
  bin [shape=plain, style="", label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#4a5568"><TR><TD ALIGN="LEFT" BORDER="0"><B>demo.idx.npy</B> offsets (int64)</TD><TD COLSPAN="4" ALIGN="LEFT" BGCOLOR="#edf2f7"><B>↓ 0</B></TD><TD COLSPAN="6" ALIGN="LEFT" BGCOLOR="#edf2f7"><B>↓ 4</B></TD><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#edf2f7"><B>↓ 10</B></TD><TD COLSPAN="1" ALIGN="LEFT" BGCOLOR="#edf2f7"><B>↓ 12</B></TD></TR><TR><TD ALIGN="LEFT" BORDER="0">position</TD><TD BORDER="0"><FONT POINT-SIZE="10">0</FONT></TD><TD BORDER="0"><FONT POINT-SIZE="10">1</FONT></TD><TD BORDER="0"><FONT POINT-SIZE="10">2</FONT></TD><TD BORDER="0"><FONT POINT-SIZE="10">3</FONT></TD><TD BORDER="0"><FONT POINT-SIZE="10">4</FONT></TD><TD BORDER="0"><FONT POINT-SIZE="10">5</FONT></TD><TD BORDER="0"><FONT POINT-SIZE="10">6</FONT></TD><TD BORDER="0"><FONT POINT-SIZE="10">7</FONT></TD><TD BORDER="0"><FONT POINT-SIZE="10">8</FONT></TD><TD BORDER="0"><FONT POINT-SIZE="10">9</FONT></TD><TD BORDER="0"><FONT POINT-SIZE="10">10</FONT></TD><TD BORDER="0"><FONT POINT-SIZE="10">11</FONT></TD><TD BORDER="0"><FONT POINT-SIZE="10">12</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><B>demo.bin</B> tokens (uint16)</TD><TD PORT="t0" BGCOLOR="#dbeafe" WIDTH="46">5001</TD><TD PORT="t1" BGCOLOR="#dbeafe" WIDTH="46">4854</TD><TD PORT="t2" BGCOLOR="#dbeafe" WIDTH="46">9514</TD><TD PORT="t3" BGCOLOR="#dbeafe" WIDTH="46">0</TD><TD PORT="t4" BGCOLOR="#fde7cf" WIDTH="46">7552</TD><TD PORT="t5" BGCOLOR="#fde7cf" WIDTH="46">5001</TD><TD PORT="t6" BGCOLOR="#fde7cf" WIDTH="46">8441</TD><TD PORT="t7" BGCOLOR="#fde7cf" WIDTH="46">9177</TD><TD PORT="t8" BGCOLOR="#fde7cf" WIDTH="46">8494</TD><TD PORT="t9" BGCOLOR="#fde7cf" WIDTH="46">0</TD><TD PORT="t10" BGCOLOR="#dcfce7" WIDTH="46">7977</TD><TD PORT="t11" BGCOLOR="#dcfce7" WIDTH="46">0</TD><TD BORDER="0">end</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">document</TD><TD COLSPAN="4" BORDER="0">"the cat sat" + EOD</TD><TD COLSPAN="6" BORDER="0">"on the mat and slept" + EOD</TD><TD COLSPAN="2" BORDER="0">"fin" + EOD</TD><TD BORDER="0"></TD></TR></TABLE>>];
  side [shape=note, style=filled, fillcolor="#edf2f7", label="demo.json (sidecar)\l{\"dtype\": \"uint16\",\l \"tokenizer_hash\": \"toy-v1\",\l \"num_docs\": 3}\l"];
  slice [shape=box, style="rounded,filled", fillcolor="#fde7cf", label="document 1 = tokens[offsets[1] : offsets[2]]\n= tokens[4 : 10] = 7552 … 8494, 0\nmemory-mapped: a slice, no parsing"];
  bin -> side [style=dashed, dir=back, label="dtype and tokenizer\nchecked on open"];
  bin -> slice [label="read"];
}
