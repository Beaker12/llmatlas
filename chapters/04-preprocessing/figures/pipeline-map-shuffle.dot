digraph pipeline_map_shuffle {
  graph [fontname="DejaVu Sans", nodesep=0.35, ranksep=0.55, newrank=true];
  node  [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=12, color="#4a5568", penwidth=1.4, margin="0.18,0.10"];
  edge  [color="#4a5568", penwidth=1.3, arrowsize=0.8];

  subgraph cluster_map1 {
    label="Map 1: one document at a time"; fontname="DejaVu Sans"; fontsize=12;
    style="rounded,filled"; fillcolor="#ebf8ff"; color="#2b6cb0";
    m2 [label="other shards\nsame stages", fillcolor="#ffffff", color="#2d3748", penwidth=1.6];
    m1 [label="shard 1\nextract → language ID → quality rules\n→ MinHash signature", fillcolor="#ffffff", color="#2d3748", penwidth=1.6];
  }

  subgraph cluster_global {
    label=""; fontname="DejaVu Sans"; fontsize=12;
    style="rounded,filled"; fillcolor="#fffaf0"; color="#c05621";
    g [label="Global step: sees every shard\n\nshuffle by band bucket\n(b keys per document)\n↓\nunion-find over candidate pairs\n↓\nlist of documents to drop", fillcolor="#feebc8", color="#9c4221", penwidth=2.0];
  }

  subgraph cluster_map2 {
    label="Map 2: one document at a time again"; labelloc="b"; fontname="DejaVu Sans"; fontsize=12;
    style="rounded,filled"; fillcolor="#f0fff4"; color="#2f855a";
    f2 [label="other shards\nsame stages", fillcolor="#ffffff", color="#2d3748", penwidth=1.6];
    f1 [label="shard 1\ndrop listed duplicates\n→ PII redaction → decontamination", fillcolor="#ffffff", color="#2d3748", penwidth=1.6];
  }

  m2 -> g; m1 -> g;
  g -> f2; g -> f1;
}
