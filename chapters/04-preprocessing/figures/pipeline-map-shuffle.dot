digraph pipeline_map_shuffle {
  graph [fontname="DejaVu Sans", nodesep=0.3, ranksep=0.7, newrank=true];
  node  [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=13, fontcolor="#1a202c", color="#2d3748", fillcolor="#ffffff", penwidth=1.4, margin="0.16,0.10"];
  edge  [color="#4a5568", penwidth=1.3, arrowsize=0.8];

  subgraph cluster_map1 {
    label="Map 1: per document"; fontname="DejaVu Sans"; fontsize=13; fontcolor="#1a202c";
    style="rounded,filled"; fillcolor="#ebf8ff"; color="#2b6cb0";
    m2 [label="other shards\nsame stages"];
    m1 [label="shard 1\nextract → language ID\n→ quality rules\n→ MinHash signature"];
  }

  subgraph cluster_global {
    label="Global step: sees every shard"; fontname="DejaVu Sans"; fontsize=13; fontcolor="#1a202c";
    style="rounded,filled"; fillcolor="#fffaf0"; color="#dd6b20";
    g [label="shuffle by band bucket\n(b keys per document)\n↓\nunion-find over\ncandidate pairs\n↓\nlist of documents\nto drop", fillcolor="#feebc8", color="#9c4221", penwidth=1.8];
  }

  subgraph cluster_map2 {
    label="Map 2: per document, again"; fontname="DejaVu Sans"; fontsize=13; fontcolor="#1a202c";
    style="rounded,filled"; fillcolor="#f0fff4"; color="#2f855a";
    f2 [label="other shards\nsame stages"];
    f1 [label="shard 1\ndrop listed duplicates\n→ PII redaction\n→ decontamination"];
  }

  m1 -> g; m2 -> g;
  g -> f1; g -> f2;
}
