digraph snapshot_layout {
  graph [fontname="DejaVu Sans", fontsize=15, nodesep=0.2, ranksep=0.35, pad=0.15];
  node [fontname="DejaVu Sans", fontsize=15, fontcolor="#1a202c", shape=box, style="rounded,filled", fillcolor="#ffffff", color="#4a5568", penwidth=1.3]; edge [fontname="DejaVu Sans", fontsize=14, fontcolor="#1a202c", color="#4a5568", penwidth=1.3];
  crawl [label=<<B>CC-MAIN-2026-39/</B><BR/>100,000 WARC files>, fillcolor="#edf2f7"];
  segments [label=<<B>segments/</B><BR/>100 segments>, fillcolor="#edf2f7"];
  warc [label=<<B>warc/</B> ~90 TB<BR/>raw HTTP>, fillcolor="#dbeafe"];
  wet [label=<<B>wet/</B> ~7 TB<BR/>text>];
  wat [label=<<B>wat/</B> ~16 TB<BR/>metadata>];
  index [label=<<B>Index line</B><BR/>…-00403.warc.gz<BR/>offset 48374322<BR/>length 9882>, fillcolor="#dcfce7"];
  get [label=<<B>Range request</B><BR/>bytes=48374322-<BR/>48384203>, fillcolor="#dcfce7"];
  file [shape=plain, style="", label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#4a5568">
    <TR><TD BGCOLOR="#f7fafc">…</TD><TD BGCOLOR="#f7fafc" PORT="req">request</TD><TD BGCOLOR="#fde7cf" PORT="hit"><B>response</B><BR/>9,882 bytes</TD><TD BGCOLOR="#f7fafc">metadata …</TD></TR>
    <TR><TD COLSPAN="4" BORDER="0"><B>…-00403.warc.gz</B> (about 1 GB):<BR/>one gzip member per record</TD></TR>
  </TABLE>>];
  crawl -> segments;
  segments -> warc; segments -> wet; segments -> wat;
  warc -> file:req:n;
  index -> get;
  get -> file:hit:n;
  {rank=same; segments; index}
  {rank=same; warc; wet; wat; get}
}
