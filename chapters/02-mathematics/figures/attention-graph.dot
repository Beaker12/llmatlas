// Scaled dot-product attention as a computation graph. Rendered with rankdir TB.
// Top row: the forward values with their shapes, left to right. Bottom row: the backward pass as its mirror; each
// vector-Jacobian product sits directly below the forward quantity it is the gradient of, and its arrows run right
// to left (written left to right with dir=back so that both rows keep one column order).
// Attributes are set per node and per edge because the renderer's theme replaces the defaults.
digraph attention_graph {
  graph [fontname="DejaVu Sans", nodesep=0.28, ranksep=0.45, newrank=true];

  Q  [label="Q\nn × dₖ", fontsize=17, shape=box, style="rounded,filled", color="#4a5568", fillcolor="#e8eef7"];
  K  [label="K\nn × dₖ", fontsize=17, shape=box, style="rounded,filled", color="#4a5568", fillcolor="#e8eef7"];
  S  [label="S = QKᵀ/√dₖ\nn × n", fontsize=17, shape=box, style="rounded,filled", color="#4a5568", fillcolor="#e8eef7"];
  A  [label="A = softmax(S)\nn × n", fontsize=17, shape=box, style="rounded,filled", color="#4a5568", fillcolor="#e8eef7"];
  V  [label="V\nn × dₖ", fontsize=17, shape=box, style="rounded,filled", color="#4a5568", fillcolor="#e8eef7"];
  O  [label="O = AV\nn × dₖ", fontsize=17, shape=box, style="rounded,filled", color="#4a5568", fillcolor="#e8eef7"];

  dQ [label="∂ℒ/∂Q =\n(∂ℒ/∂S) K/√dₖ", fontsize=17, shape=box, style="rounded,filled", color="#4a5568", fillcolor="#fdf1e6"];
  dK [label="∂ℒ/∂K =\n(∂ℒ/∂S)ᵀ Q/√dₖ", fontsize=17, shape=box, style="rounded,filled", color="#4a5568", fillcolor="#fdf1e6"];
  dS [label="∂ℒ/∂S =\nA ⊙ (G − (G ⊙ A)11ᵀ)", fontsize=17, shape=box, style="rounded,filled", color="#4a5568", fillcolor="#fdf1e6"];
  G  [label="G = ∂ℒ/∂A\n= (∂ℒ/∂O) Vᵀ", fontsize=17, shape=box, style="rounded,filled", color="#4a5568", fillcolor="#fdf1e6"];
  dV [label="∂ℒ/∂V =\nAᵀ (∂ℒ/∂O)", fontsize=17, shape=box, style="rounded,filled", color="#4a5568", fillcolor="#fdf1e6"];
  dO [label="∂ℒ/∂O\nfrom above", fontsize=17, shape=box, style="rounded,filled", color="#4a5568", fillcolor="#fdf1e6"];

  { rank=same; Q; K; S; A; V; O; }
  { rank=same; dQ; dK; dS; G; dV; dO; }

  // forward
  Q -> K [style=invis];
  K -> S [color="#4a5568", penwidth=1.4];
  Q -> S [color="#4a5568", penwidth=1.4];
  S -> A [color="#4a5568", penwidth=1.4];
  A -> V [style=invis];
  V -> O [color="#4a5568", penwidth=1.4];
  A -> O [color="#4a5568", penwidth=1.4];

  // backward, right to left
  dQ -> dK [style=invis];
  dK -> dS [dir=back, style=dashed, color="#d62728", penwidth=1.6];
  dQ -> dS [dir=back, style=dashed, color="#d62728", penwidth=1.6];
  dS -> G  [dir=back, style=dashed, color="#d62728", penwidth=1.6];
  G -> dV  [style=invis];
  dV -> dO [dir=back, style=dashed, color="#d62728", penwidth=1.6];
  G -> dO  [dir=back, style=dashed, color="#d62728", penwidth=1.6];

  // columns
  Q -> dQ [style=invis]; K -> dK [style=invis]; S -> dS [style=invis];
  A -> G [style=invis]; V -> dV [style=invis]; O -> dO [style=invis];
}
