digraph ScaledDotProductAttention {
    graph [fontname="Arial" fontsize=13 bgcolor=white];

    x [label=<<b>Input X</b>  (n × d)> shape=box style="rounded,filled" fillcolor="#fffaf0" color="#975a16" penwidth=1.4 fontsize=13 fontcolor="#1a202c"];
    q [label=<<b>Queries Q</b><br/>n × dₖ> shape=box style="rounded,filled" fillcolor="#ebf4ff" color="#2d3748" penwidth=1.4 fontsize=13 fontcolor="#1a202c"];
    k [label=<<b>Keys K</b><br/>n × dₖ> shape=box style="rounded,filled" fillcolor="#ebf4ff" color="#2d3748" penwidth=1.4 fontsize=13 fontcolor="#1a202c"];
    v [label=<<b>Values V</b><br/>n × dᵥ> shape=box style="rounded,filled" fillcolor="#ebf4ff" color="#2d3748" penwidth=1.4 fontsize=13 fontcolor="#1a202c"];
    { rank=same; q; k; v; }
    s [label=<<b>Scores S = QKᵀ / √dₖ</b>   (n × n)> shape=box style="rounded,filled" fillcolor="#ebf4ff" color="#2d3748" penwidth=1.4 fontsize=13 fontcolor="#1a202c"];
    m [label=<<b>Mask (optional)</b>: add −∞ to hidden pairs> shape=box style="rounded,filled" fillcolor="#fff5f5" color="#9b2c2c" penwidth=1.4 fontsize=13 fontcolor="#1a202c"];
    a [label=<<b>Weights A = softmax(S)</b>: each row sums to 1> shape=box style="rounded,filled" fillcolor="#ebf4ff" color="#2d3748" penwidth=1.4 fontsize=13 fontcolor="#1a202c"];
    o [label=<<b>Output O = AV</b>   (n × dᵥ)> shape=box style="rounded,filled" fillcolor="#f0fff4" color="#276749" penwidth=1.4 fontsize=13 fontcolor="#1a202c"];
    x -> q [color="#2d3748" penwidth=1.3 fontsize=12 fontcolor="#1a202c"];
    x -> k [color="#2d3748" penwidth=1.3 fontsize=12 fontcolor="#1a202c"];
    x -> v [color="#2d3748" penwidth=1.3 fontsize=12 fontcolor="#1a202c"];
    q -> s [color="#2d3748" penwidth=1.3 fontsize=12 fontcolor="#1a202c"];
    k -> s [color="#2d3748" penwidth=1.3 fontsize=12 fontcolor="#1a202c"];
    s -> m [color="#2d3748" penwidth=1.3 fontsize=12 fontcolor="#1a202c"];
    m -> a [color="#2d3748" penwidth=1.3 fontsize=12 fontcolor="#1a202c"];
    a -> o [color="#2d3748" penwidth=1.3 fontsize=12 fontcolor="#1a202c"];
    v -> o [color="#2d3748" penwidth=1.3 fontsize=12 fontcolor="#1a202c"];
}
