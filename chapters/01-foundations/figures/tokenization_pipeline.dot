digraph TokenizationPipeline {
    graph [fontname="Arial" fontsize=13 bgcolor=white label=<<b>Input: "The cat sat"</b>> labelloc=t];

    s0 [label=<<b>Normalization</b><br/>Unicode form, case, spaces> shape=box style="rounded,filled" fillcolor="#ebf4ff" color="#2d3748" penwidth=1.4 fontsize=13 fontcolor="#1a202c" width=2.4];
    e0 [label=<&quot;The cat sat&quot; (GPT-2: unchanged)> shape=box style="rounded,filled" fillcolor="#fffaf0" color="#975a16" penwidth=1.4 fontsize=13 fontcolor="#1a202c" width=3.1];
    { rank=same; s0; e0; }
    s0 -> e0 [style=dotted arrowhead=none color="#975a16" penwidth=1.2];
    s1 [label=<<b>Pre-tokenization</b><br/>split into chunks> shape=box style="rounded,filled" fillcolor="#ebf4ff" color="#2d3748" penwidth=1.4 fontsize=13 fontcolor="#1a202c" width=2.4];
    e1 [label=<&quot;The&quot; | &quot; cat&quot; | &quot; sat&quot;> shape=box style="rounded,filled" fillcolor="#fffaf0" color="#975a16" penwidth=1.4 fontsize=13 fontcolor="#1a202c" width=3.1];
    { rank=same; s1; e1; }
    s1 -> e1 [style=dotted arrowhead=none color="#975a16" penwidth=1.2];
    s2 [label=<<b>Subword model</b><br/>apply the BPE merges> shape=box style="rounded,filled" fillcolor="#ebf4ff" color="#2d3748" penwidth=1.4 fontsize=13 fontcolor="#1a202c" width=2.4];
    e2 [label=<The | Ġcat | Ġsat> shape=box style="rounded,filled" fillcolor="#fffaf0" color="#975a16" penwidth=1.4 fontsize=13 fontcolor="#1a202c" width=3.1];
    { rank=same; s2; e2; }
    s2 -> e2 [style=dotted arrowhead=none color="#975a16" penwidth=1.2];
    s3 [label=<<b>Vocabulary lookup</b><br/>one id per token> shape=box style="rounded,filled" fillcolor="#ebf4ff" color="#2d3748" penwidth=1.4 fontsize=13 fontcolor="#1a202c" width=2.4];
    e3 [label=<464, 3797, 3332> shape=box style="rounded,filled" fillcolor="#fffaf0" color="#975a16" penwidth=1.4 fontsize=13 fontcolor="#1a202c" width=3.1];
    { rank=same; s3; e3; }
    s3 -> e3 [style=dotted arrowhead=none color="#975a16" penwidth=1.2];
    s4 [label=<<b>Embedding lookup</b><br/>one row of W_E per id> shape=box style="rounded,filled" fillcolor="#f0fff4" color="#276749" penwidth=1.4 fontsize=13 fontcolor="#1a202c" width=2.4];
    e4 [label=<X: 3 × 768 (d = 768)> shape=box style="rounded,filled" fillcolor="#fffaf0" color="#975a16" penwidth=1.4 fontsize=13 fontcolor="#1a202c" width=3.1];
    { rank=same; s4; e4; }
    s4 -> e4 [style=dotted arrowhead=none color="#975a16" penwidth=1.2];
    s0 -> s1 [color="#2d3748" penwidth=1.3 fontsize=12 fontcolor="#1a202c"];
    e0 -> e1 [style=invis];
    s1 -> s2 [color="#2d3748" penwidth=1.3 fontsize=12 fontcolor="#1a202c"];
    e1 -> e2 [style=invis];
    s2 -> s3 [color="#2d3748" penwidth=1.3 fontsize=12 fontcolor="#1a202c"];
    e2 -> e3 [style=invis];
    s3 -> s4 [color="#2d3748" penwidth=1.3 fontsize=12 fontcolor="#1a202c"];
    e3 -> e4 [style=invis];
}
