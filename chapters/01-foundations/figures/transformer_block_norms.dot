digraph TransformerBlockNorms {
    graph [fontname="Arial" fontsize=13 bgcolor=white];

    subgraph cluster_post {
        label=<<b>Post-LN (2017)</b>>; fontsize=13; style="rounded,filled"; fillcolor="#f7fafc"; color="#2d3748"; penwidth=1.2;
        a0 [label=<<b>x</b>> shape=box style="rounded,filled" fillcolor="#fffaf0" color="#975a16" penwidth=1.4 fontsize=13 fontcolor="#1a202c"];
        a1 [label=<<b>Multi-head attention</b>> shape=box style="rounded,filled" fillcolor="#ebf4ff" color="#2d3748" penwidth=1.4 fontsize=13 fontcolor="#1a202c"];
        a2 [label=<<b>+</b>> shape=circle style="filled" fillcolor="#ebf4ff" color="#2d3748" penwidth=1.4 fontsize=13 fontcolor="#1a202c" width=0.45 fixedsize=true fontsize=16];
        a3 [label=<<b>Norm</b>> shape=box style="rounded,filled" fillcolor="#fff5f5" color="#9b2c2c" penwidth=1.4 fontsize=13 fontcolor="#1a202c"];
        a4 [label=<Norm(x + MHA(x))> shape=box style="rounded,filled" fillcolor="#f0fff4" color="#276749" penwidth=1.4 fontsize=13 fontcolor="#1a202c"];
        a0 -> a1 [color="#2d3748" penwidth=1.3 fontsize=12 fontcolor="#1a202c"];
        a1 -> a2 [color="#2d3748" penwidth=1.3 fontsize=12 fontcolor="#1a202c"];
        a2 -> a3 [color="#2d3748" penwidth=1.3 fontsize=12 fontcolor="#1a202c"];
        a3 -> a4 [color="#2d3748" penwidth=1.3 fontsize=12 fontcolor="#1a202c"];
        a0 -> a2 [color="#2d3748" penwidth=1.3 fontsize=12 fontcolor="#1a202c" label=<residual> style=dashed];
    }
    subgraph cluster_pre {
        label=<<b>Pre-LN (GPT-2 onward)</b>>; fontsize=13; style="rounded,filled"; fillcolor="#f7fafc"; color="#2d3748"; penwidth=1.2;
        b0 [label=<<b>x</b>> shape=box style="rounded,filled" fillcolor="#fffaf0" color="#975a16" penwidth=1.4 fontsize=13 fontcolor="#1a202c"];
        b1 [label=<<b>Norm</b>> shape=box style="rounded,filled" fillcolor="#fff5f5" color="#9b2c2c" penwidth=1.4 fontsize=13 fontcolor="#1a202c"];
        b2 [label=<<b>Multi-head attention</b>> shape=box style="rounded,filled" fillcolor="#ebf4ff" color="#2d3748" penwidth=1.4 fontsize=13 fontcolor="#1a202c"];
        b3 [label=<<b>+</b>> shape=circle style="filled" fillcolor="#ebf4ff" color="#2d3748" penwidth=1.4 fontsize=13 fontcolor="#1a202c" width=0.45 fixedsize=true fontsize=16];
        b4 [label=<x + MHA(Norm(x))> shape=box style="rounded,filled" fillcolor="#f0fff4" color="#276749" penwidth=1.4 fontsize=13 fontcolor="#1a202c"];
        b0 -> b1 [color="#2d3748" penwidth=1.3 fontsize=12 fontcolor="#1a202c"];
        b1 -> b2 [color="#2d3748" penwidth=1.3 fontsize=12 fontcolor="#1a202c"];
        b2 -> b3 [color="#2d3748" penwidth=1.3 fontsize=12 fontcolor="#1a202c"];
        b3 -> b4 [color="#2d3748" penwidth=1.3 fontsize=12 fontcolor="#1a202c"];
        b0 -> b3 [color="#2d3748" penwidth=1.3 fontsize=12 fontcolor="#1a202c" label=<residual> style=dashed];
    }
}
