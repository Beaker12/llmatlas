digraph BpeMerges {
    graph [fontname="Arial" fontsize=13 bgcolor=white label=<<b>Corpus: hello, world, hello, help, held</b>> labelloc=t];

    m0 [label=<<b>Start</b><br/>characters> shape=box style="rounded,filled" fillcolor="white" color="#2d3748" penwidth=1.4 fontsize=13 fontcolor="#1a202c" width=2.3];
    c0 [label=<h e l l o ×2 · w o r l d · h e l p · h e l d> shape=box style="rounded,filled" fillcolor="#fffaf0" color="#975a16" penwidth=1.4 fontsize=13 fontcolor="#1a202c" width=4.0];
    { rank=same; m0; c0; }
    m0 -> c0 [style=dotted arrowhead=none color="#975a16" penwidth=1.2];
    m1 [label=<<b>Merge 1:</b> h + e → he<br/>count 4, tied with e + l> shape=box style="rounded,filled" fillcolor="#ebf4ff" color="#2d3748" penwidth=1.4 fontsize=13 fontcolor="#1a202c" width=2.3];
    c1 [label=<he l l o ×2 · w o r l d · he l p · he l d> shape=box style="rounded,filled" fillcolor="#fffaf0" color="#975a16" penwidth=1.4 fontsize=13 fontcolor="#1a202c" width=4.0];
    { rank=same; m1; c1; }
    m1 -> c1 [style=dotted arrowhead=none color="#975a16" penwidth=1.2];
    m0 -> m1 [color="#2d3748" penwidth=1.3 fontsize=12 fontcolor="#1a202c"];
    c0 -> c1 [style=invis];
    m2 [label=<<b>Merge 2:</b> he + l → hel<br/>count 4> shape=box style="rounded,filled" fillcolor="#ebf4ff" color="#2d3748" penwidth=1.4 fontsize=13 fontcolor="#1a202c" width=2.3];
    c2 [label=<hel l o ×2 · w o r l d · hel p · hel d> shape=box style="rounded,filled" fillcolor="#fffaf0" color="#975a16" penwidth=1.4 fontsize=13 fontcolor="#1a202c" width=4.0];
    { rank=same; m2; c2; }
    m2 -> c2 [style=dotted arrowhead=none color="#975a16" penwidth=1.2];
    m1 -> m2 [color="#2d3748" penwidth=1.3 fontsize=12 fontcolor="#1a202c"];
    c1 -> c2 [style=invis];
    m3 [label=<<b>Merge 3:</b> hel + l → hell<br/>count 2> shape=box style="rounded,filled" fillcolor="#ebf4ff" color="#2d3748" penwidth=1.4 fontsize=13 fontcolor="#1a202c" width=2.3];
    c3 [label=<hell o ×2 · w o r l d · hel p · hel d> shape=box style="rounded,filled" fillcolor="#fffaf0" color="#975a16" penwidth=1.4 fontsize=13 fontcolor="#1a202c" width=4.0];
    { rank=same; m3; c3; }
    m3 -> c3 [style=dotted arrowhead=none color="#975a16" penwidth=1.2];
    m2 -> m3 [color="#2d3748" penwidth=1.3 fontsize=12 fontcolor="#1a202c"];
    c2 -> c3 [style=invis];
    m4 [label=<<b>Merge 4:</b> hell + o → hello<br/>count 2> shape=box style="rounded,filled" fillcolor="#ebf4ff" color="#2d3748" penwidth=1.4 fontsize=13 fontcolor="#1a202c" width=2.3];
    c4 [label=<hello ×2 · w o r l d · hel p · hel d> shape=box style="rounded,filled" fillcolor="#fffaf0" color="#975a16" penwidth=1.4 fontsize=13 fontcolor="#1a202c" width=4.0];
    { rank=same; m4; c4; }
    m4 -> c4 [style=dotted arrowhead=none color="#975a16" penwidth=1.2];
    m3 -> m4 [color="#2d3748" penwidth=1.3 fontsize=12 fontcolor="#1a202c"];
    c3 -> c4 [style=invis];
    enc [label=<<b>Encode an unseen word</b><br/>apply the 4 merges in order> shape=box style="rounded,filled" fillcolor="#f0fff4" color="#276749" penwidth=1.4 fontsize=13 fontcolor="#1a202c" width=2.3];
    res [label=<helper → hel | p | e | r | &lt;/w&gt;> shape=box style="rounded,filled" fillcolor="#f0fff4" color="#276749" penwidth=1.4 fontsize=13 fontcolor="#1a202c" width=4.0];
    { rank=same; enc; res; }
    enc -> res [style=dotted arrowhead=none color="#975a16" penwidth=1.2];
    m4 -> enc [color="#2d3748" penwidth=1.3 fontsize=12 fontcolor="#1a202c"];
    c4 -> res [style=invis];
}
