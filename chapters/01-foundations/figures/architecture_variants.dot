digraph ArchitectureVariants {
    graph [fontname="Arial" fontsize=10 rankdir=TB nodesep=0.55 ranksep=0.45 bgcolor=white newrank=true];
    node  [shape=box style=rounded fontname="Arial" fontsize=10 penwidth=1 color="#4a5568"];
    edge  [fontname="Arial" fontsize=9 color="#4a5568" arrowsize=0.7];

    subgraph cluster_enc {
        label="Encoder-only (BERT)";
        style=solid; color="#63b3ed"; fontname="Arial"; fontsize=11; bgcolor=white;
        a_in [label=<<b>Input</b><br/><font point-size="10">[CLS] the [MASK] sat on the mat</font>> class="kind-entry"];
        a_stack [label=<<b>Encoder stack</b><br/><font point-size="10">bidirectional self-attention:</font><br/><font point-size="10">every token sees every token</font>> class="kind-llm"];
        a_out [label=<<b>Output</b><br/><font point-size="10">one vector per token:</font><br/><font point-size="10">predict "cat"; classify via [CLS]</font>> class="kind-result"];
        a_in -> a_stack;
        a_stack -> a_out;
    }

    /* Invisible spacer keeps neighbouring panels apart */
    sp1 [label="" style=invis width=0.3 class="kind-agent"];

    subgraph cluster_dec {
        label="Decoder-only (GPT)";
        style=solid; color="#9f7aea"; fontname="Arial"; fontsize=11; bgcolor=white;
        b_in [label=<<b>Input</b><br/><font point-size="10">the cat sat on the</font>> class="kind-entry"];
        b_stack [label=<<b>Decoder stack</b><br/><font point-size="10">causal self-attention:</font><br/><font point-size="10">each token sees only earlier tokens</font>> class="kind-llm"];
        b_out [label=<<b>Output</b><br/><font point-size="10">next-token distribution</font><br/><font point-size="10">at every position, e.g. "mat"</font>> class="kind-result"];
        b_in -> b_stack;
        b_stack -> b_out;
    }

    sp2 [label="" style=invis width=0.3 class="kind-agent"];

    subgraph cluster_encdec {
        label="Encoder-decoder (T5)";
        style=solid; color="#68d391"; fontname="Arial"; fontsize=11; bgcolor=white;
        c_src [label=<<b>Source</b><br/><font point-size="10">translate English to German: the cat sat</font>> class="kind-entry"];
        c_enc [label=<<b>Encoder stack</b><br/><font point-size="10">bidirectional over source</font>> class="kind-llm"];
        c_dec [label=<<b>Decoder stack</b><br/><font point-size="10">causal self-attention</font><br/><font point-size="10">+ cross-attention to encoder</font>> class="kind-llm"];
        c_out [label=<<b>Target</b><br/><font point-size="10">generated left to right,</font><br/><font point-size="10">each token fed back to decoder</font>> class="kind-result"];
        c_src -> c_enc;
        c_enc -> c_dec;
        c_dec -> c_out;
    }

    { rank=same; a_in; sp1; b_in; sp2; c_src; }
}
